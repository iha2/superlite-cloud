# Copy to .env and fill in. Never commit .env.

# Encrypts stored provider keys. Must be high-entropy. Generate with: openssl rand -hex 32
# In 0.1 the vault key is the SHA-256 of this value, with no salted KDF.
SLCLOUD_MASTER_KEY=

# Public URL that agents and browsers use to reach the server.
SLCLOUD_URL=http://localhost:8787

# Task workdir root. The same path is used on the host and in the worker.
SLCLOUD_WORK=/srv/slcloud/work

# docker (default) or process
SLCLOUD_SANDBOX=docker

# Set to 1 to run sandboxes under gVisor (runsc), if it is installed on the host.
SLCLOUD_GVISOR=0

SLCLOUD_WORKER_IMAGE=slcloud-worker:0.1.0

# Provider keys are not set here. Store them with `slcloud key set`.
