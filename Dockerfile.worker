# Worker and sandbox image. The worker service runs `slcloud worker` from this image,
# and every task sandbox also uses it (SLCLOUD_WORKER_IMAGE=slcloud-worker:0.1.0).
FROM python:3.12-slim-bookworm

ARG CLAUDE_VERSION=2.1.325
ARG CODEX_VERSION=0.169.0
ARG GEMINI_VERSION=0.68.0
ARG CURSOR_VERSION=2026.11.13-eacade1
ARG SUPERLITE_VERSION=v4.2.0
ARG SUPERLITE_REPO=https://github.com/iha2/superlite

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH=/root/.local/bin:${PATH}

# git is needed for clone and hand-back; node runs the npm agent CLIs.
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl git \
 && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
 && apt-get install -y --no-install-recommends nodejs \
 && rm -rf /var/lib/apt/lists/*

# Docker CLI only (no daemon). The worker starts sandboxes through the mounted host socket.
RUN install -m 0755 -d /etc/apt/keyrings \
 && curl -fsSL https://download.docker.com/linux/debian/gpg -o /etc/apt/keyrings/docker.asc \
 && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/debian bookworm stable" > /etc/apt/sources.list.d/docker.list \
 && apt-get update \
 && apt-get install -y --no-install-recommends docker-ce-cli \
 && rm -rf /var/lib/apt/lists/*

# Agent CLIs, pinned by the ARGs above.
RUN npm install -g \
      @anthropic-ai/claude-code@${CLAUDE_VERSION} \
      @openai/codex@${CODEX_VERSION} \
      @google/gemini-cli@${GEMINI_VERSION} \
 && npm cache clean --force

# cursor-agent, pinned by CURSOR_VERSION. Installed from the versioned package, not the
# unpinned installer script. Symlinks in /root/.local/bin expose `agent` and `cursor-agent`.
RUN ARCH="$(dpkg --print-architecture)" \
 && case "$ARCH" in amd64) CARCH=x64 ;; arm64) CARCH=arm64 ;; *) echo "unsupported arch: $ARCH" >&2; exit 1 ;; esac \
 && DEST=/root/.local/share/cursor-agent/versions/${CURSOR_VERSION} \
 && mkdir -p "$DEST" /root/.local/bin \
 && curl -fsSL "https://downloads.cursor.com/lab/${CURSOR_VERSION}/linux/${CARCH}/agent-cli-package.tar.gz" -o /tmp/cursor-agent.tar.gz \
 && tar -xzf /tmp/cursor-agent.tar.gz -C "$DEST" \
 && rm /tmp/cursor-agent.tar.gz \
 && ln -sf "$DEST/cursor-agent" /root/.local/bin/cursor-agent \
 && ln -sf "$DEST/cursor-agent" /root/.local/bin/agent

# superlite plugin, from its git tag.
RUN git clone --depth 1 --branch ${SUPERLITE_VERSION} ${SUPERLITE_REPO} /opt/superlite

WORKDIR /app
COPY pyproject.toml ./
COPY src ./src
RUN pip install --no-cache-dir .

CMD ["slcloud", "worker"]
